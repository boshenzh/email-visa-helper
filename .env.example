# Copy to .env on the server. Leave secrets empty in git.
# The DeepSeek key is supplied by the operator outside this repo.
# This demo does not read a key from chat and does not call DeepSeek
# for inbound mail.

# mock: do not call DeepSeek. Public-topic mail stays on the local draft.
# live: call Chat Completions only when DEEPSEEK_API_KEY is already in the
# environment, and only with a public topic id plus official snippets.
# Raw mail is not sent either way. Do not paste the key into chat or git.
AGENT_MODE=mock

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Documented Chat Completions enum as of 2026-11-08: deepseek-flash | deepseek-v4-pro
# Default is deepseek-flash. A coordinator check saw this id answer; this VM has no key.
DEEPSEEK_MODEL=deepseek-flash
# Keep disabled. Thinking mode is on unless this is sent, and tool
# follow-ups would have to store reasoning_content. This demo will not.
DEEPSEEK_THINKING=disabled

# Shared secret between the Cloudflare email worker and this process.
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGRESS_TOKEN=
# Separate token for operator approve/delete/export. The worker must not have it.
OPERATOR_TOKEN=

MAILBOX=visa@boshen.dev
LISTEN_HOST=127.0.0.1
PORT=8080
DATA_DIR=./data

# Optional. If set (16+ characters), case vault files are AES-256-GCM.
# Empty means the demo vault is plaintext. Do not store real records.
VAULT_KEY=

# preview: store the outbox draft. cloudflare: allow the REST sender below
# to run, and only when AUTO_REPLY=general_info.
DELIVERY_MODE=preview
# off: never send. general_info: send only a GENERAL_INFORMATION draft to the
# DMARC-authenticated sender. Personal, clerical, and review drafts stay local.
AUTO_REPLY=off
# Cloudflare Email Sending REST. Not Email Routing, and not generic SMTP.
# POST /accounts/{account_id}/email/sending/send
# Leave both empty until a reviewed send test. Do not put a real token in git.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
PUBLIC_LAUNCH=blocked
KILL_SWITCH=off

# Product choice for this synthetic/demo store only. Not a legal retention rule.
CASE_TTL_DAYS=30

MAX_MODEL_CALLS=6
MAX_TOOL_ACTIONS=8
MAX_WALL_MS=20000
MAX_TOKENS=8000
MAX_COST_USD=0.25
SENDER_HOURLY_LIMIT=8
GLOBAL_HOURLY_LIMIT=100
MAX_REPLIES_PER_THREAD=5

MAX_TEXT_CHARS=20000
MAX_ATTACHMENT_BYTES=5000000
MAX_ATTACHMENTS=5
